+def hud_origins(width, height):
+    """Possible x origins of the 16:9 HUD on screen, with its width.
+
+    On ultrawide screens (21:9, 32:9) the HUD may stay at the left edge or sit
+    in a centered 16:9 area; both positions are tried.
+    """
+    base = round(height*16/9)
+    if width <= base+2:
+        return [0], width
+    return [0, (width-base)//2], base
+
